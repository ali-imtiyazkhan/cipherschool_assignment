generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Problem — the LLD challenge itself
model Problem {
  id           String   @id @default(cuid())
  title        String
  description  String
  requirements String[] // e.g. ["Support multiple vehicle types", "Track available spots"]
  constraints  String[] // e.g. ["No external libraries", "Single-process only"]
  difficulty   Difficulty @default(MEDIUM)
  createdAt    DateTime @default(now())

  attempts     Attempt[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// User — kept minimal, no real auth for the MVP
model User {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  attempts  Attempt[]
}

// Attempt — one learner's try at one problem
model Attempt {
  id        String        @id @default(cuid())
  problem   Problem       @relation(fields: [problemId], references: [id])
  problemId String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  status    AttemptStatus @default(IN_PROGRESS)
  startedAt DateTime      @default(now())

  submissions Submission[]

  @@index([problemId, userId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

// Submission — an immutable snapshot of what was submitted
// Owns its own evaluation lifecycle state
model Submission {
  id          String           @id @default(cuid())
  attempt     Attempt          @relation(fields: [attemptId], references: [id])
  attemptId   String
  content     String           // markdown design doc
  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime         @default(now())
  failureReason String?        // populated if status = FAILED

  evaluations Evaluation[]

  @@index([attemptId])
}

enum SubmissionStatus {
  PENDING
  EVALUATING
  COMPLETED
  FAILED
}

// Evaluation — structured, evidence-based feedback
// One Submission can have multiple Evaluations
// (e.g. one from DeterministicEvaluator, one from AIEvaluator)
model Evaluation {
  id             String        @id @default(cuid())
  submission     Submission    @relation(fields: [submissionId], references: [id])
  submissionId   String
  evaluatorType  EvaluatorType
  criteria       Json          // [{ criterion, score, evidence, concern, suggestion }]
  overallSummary String
  confidence     Float?        // 0–1, mainly meaningful for AI evaluations
  createdAt      DateTime      @default(now())

  @@index([submissionId])
}

enum EvaluatorType {
  DETERMINISTIC
  AI
}
